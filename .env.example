# Copy this file to .env.local for local development.
# In production (Vercel), set these under Project Settings -> Environment Variables.

# Password to log into /dashboard and upload CSVs. Required.
DASHBOARD_PASSWORD=change-me-to-something-only-you-know

# Optional: used to sign login session cookies. If not set, DASHBOARD_PASSWORD
# is used instead. Set this to any long random string for a bit of extra
# separation between "my password" and "my cookie-signing secret".
SESSION_SECRET=

# BLOB_READ_WRITE_TOKEN is provided automatically by Vercel once you enable
# Blob storage on your project (Storage tab -> Create Database -> Blob).
# You do NOT need to set this yourself locally -- without it, the app just
# stores uploaded card data in a local data/cards.json file, which is fine
# for testing on your own machine.
# BLOB_READ_WRITE_TOKEN=
